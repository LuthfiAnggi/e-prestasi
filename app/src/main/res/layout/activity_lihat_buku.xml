<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Material Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_arrow_left"
        app:title="Progress Belajar Santri"
        app:titleTextColor="@android:color/white"
        android:elevation="4dp" />

    <!-- Content dalam NestedScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            tools:context=".pengajar.ActivityTambahBuku">

            <!-- CardView untuk menampilkan informasi Santri -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewSantri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Gambar Santri dengan elevation untuk efek bayangan -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imvSantri"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="#EEEEEE"
                        app:strokeWidth="2dp"
                        android:elevation="2dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:srcCompat="@tools:sample/avatars" />

                    <!-- Container untuk informasi santri -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toEndOf="@id/imvSantri"
                        app:layout_constraintTop_toTopOf="@id/imvSantri"
                        app:layout_constraintBottom_toBottomOf="@id/imvSantri"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Nama Santri -->
                        <TextView
                            android:id="@+id/tvSantri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ahmad Rasyid"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#2D3142" />

                        <!-- Info tambahan santri -->
                        <TextView
                            android:id="@+id/tvKelas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kelas X - Iqro"
                            android:textSize="15sp"
                            android:textColor="#656B8A"
                            android:layout_marginTop="4dp" />

                        <!-- Status chip -->
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aktif"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/status_chip_background"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CardView untuk memilih tanggal awal dan akhir -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Section title -->
                    <TextView
                        android:id="@+id/tvRangeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rentang Tanggal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2D3142"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Tanggal Awal dengan Material Design -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTanggalAwal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:endIconMode="custom"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvRangeTitle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTanggalAwal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:hint="Pilih Tanggal Awal"
                            android:textSize="16sp"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Tanggal Akhir dengan Material Design -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTanggalAkhir"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:endIconMode="custom"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilTanggalAwal">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTanggalAkhir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:hint="Pilih Tanggal Akhir"
                            android:textSize="16sp"
                            android:minHeight="48dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Button dengan Material Design -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTampilkanTanggal"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Tampilkan Tanggal"
                        android:textSize="16sp"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tilTanggalAkhir" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Label untuk RecyclerView Tanggal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Tanggal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D3142"
                android:layout_marginBottom="8dp"/>

            <!-- RecyclerView untuk tanggal dengan card background -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:clipToPadding="false" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Progress"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2D3142"
                android:layout_marginBottom="8dp"/>

            <!-- CardView untuk Progress Harian dengan style Material Design -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progress Harian"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2D3142"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Tanggal dengan ikon -->
                    <ImageView
                        android:id="@+id/ivDateIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/calendar31"
                        android:layout_marginTop="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textView2" />

                    <TextView
                        android:id="@+id/tvTanggal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="14 Mei 2025"
                        android:textSize="15sp"
                        android:textColor="#4E4B66"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/ivDateIcon"
                        app:layout_constraintTop_toTopOf="@id/ivDateIcon"
                        app:layout_constraintBottom_toBottomOf="@id/ivDateIcon"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Container untuk data progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/progress_background"
                        android:padding="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTanggal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Info Jilid dengan layout yang lebih baik -->

                        <!-- Info Halaman -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Halaman"
                                android:textSize="15sp"
                                android:textColor="#2D3142" />

                            <TextView
                                android:id="@+id/tvHalaman"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15-16"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#4E4B66" />
                        </LinearLayout>

                        <!-- Info Nilai -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="Nilai"
                                android:textSize="15sp"
                                android:textColor="#2D3142" />

                            <TextView
                                android:id="@+id/tvNilai"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#159F5C" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hafalan Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Hafalan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2D3142"
                android:layout_marginBottom="8dp"/>

            <!-- Row untuk 2 card hafalan side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <!-- CardView untuk Hafalan Surah -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardViewHafalanSurah"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header dengan icon -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/quran_24"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hafalan Surah"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2D3142"/>
                        </LinearLayout>

                        <!-- Surah Name -->
                        <TextView
                            android:id="@+id/tvSurah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Al-Fatihah"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#4E4B66" />

                        <!-- Nilai dengan badge style -->
                        <TextView
                            android:id="@+id/tvNilaiSurah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="90"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/nilai_badge_background"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CardView untuk Hafalan Do'a -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardViewHafalanDoa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    android:layout_marginStart="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header dengan icon -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/pray"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hafalan Do'a"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#2D3142"/>
                        </LinearLayout>

                        <!-- Doa Name -->
                        <TextView
                            android:id="@+id/tvDoa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Do'a Sebelum Makan"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#4E4B66" />

                        <!-- Nilai dengan badge style -->
                        <TextView
                            android:id="@+id/tvNilaiDoa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/nilai_badge_background"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>